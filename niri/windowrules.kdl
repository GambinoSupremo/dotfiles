// ============================================================
// Niri Window Rules - Per-app opacity + comms pinning + blur
// Mirrors ~/.config/mango/rule.conf
// ============================================================

// === Global defaults ===
window-rule {
    opacity 0.97
    background-effect {
        blur true
    }
}

// === Comms (pinned to "comms" workspace on Philips) ===
window-rule {
    match app-id=r#"^vesktop$"#
    default-column-width { proportion 0.5; }
    open-on-workspace "comms"
    opacity 0.85
}

window-rule {
    match app-id=r#"^signal$"#
    default-column-width { proportion 0.5; }
    open-on-workspace "comms"
    opacity 0.85
}
window-rule {
    match app-id=r#"^tidal-hifi$"#
    default-column-width { proportion 0.5; }
    open-on-workspace "comms"
    opacity 0.85
}

// === Editors ===
window-rule {
    match app-id=r#"^dev\.zed\.Zed$"#
    match app-id=r#"^zeditor$"#
    opacity 0.97
}

// === Browser ===
window-rule {
    match app-id=r#"^zen$"#
    match app-id=r#"^zen-browser$"#
    match app-id=r#"^app\.zen_browser\.zen$"#
    opacity 0.97
}

// === Notes ===
window-rule {
    match app-id="obsidian"
    opacity 0.97
}

// === File manager ===
window-rule {
    match app-id=r#"^org\.gnome\.Nautilus$"#
    opacity 0.95
}

// === Steam client (pinned to "gaming" workspace on Alienware) ===
// Targets only the main Steam window, not games (steam_app_*).
// Excludes toast notifications which should remain floating popups.
window-rule {
    match app-id="^steam$"
    default-column-width { proportion 1.0; }
    exclude title=r#"^notificationtoasts_\d+_desktop$"#
    open-on-workspace "gaming"
    opacity 0.95
}

// === Steam games — restore primary-plane direct scanout ===
// The global rule in config.kdl sets clip-to-geometry=true +
// geometry-corner-radius=6 for rounded corners on every window.
// clip-to-geometry prevents niri from scanning a surface directly
// to the primary DRM plane (the surface isn't fully visible once
// clipped), forcing all game frames through the compositor pipeline.
// opacity < 1.0 (inherited from the global 0.97 rule above) also
// blocks direct scanout. Both are reverted here so fullscreen game
// frames bypass the compositor entirely, matching KWin behaviour.
window-rule {
    match app-id=r#"^steam_app_.*$"#
    open-on-workspace "gaming"
    geometry-corner-radius 0
    clip-to-geometry false
    opacity 1.0
}

// === Background blur (xray) ===
// Apps below have lowered opacity (0.85) so blur is visible through them.
// Xray is implicit when blur is true — only the wallpaper is blurred,
// not other windows behind. See niri docs: Window Effects.
window-rule {
    match app-id=r#"^vesktop$"#
    background-effect {
        blur true
    }
}
window-rule {
    match app-id=r#"^signal$"#
    background-effect {
        blur true
    }
}
window-rule {
    match app-id=r#"^tidal-hifi$"#
    background-effect {
        blur true
    }
}
window-rule {
    match app-id=r#"^zen-browser$"#
    match app-id=r#"^app\.zen_browser\.zen$"#
    background-effect {
        blur true
    }
}

// === Floating terminal ===
window-rule {
    match app-id="com.ghostty.floating"
    open-floating true
}
