// Niri window rules — per-app opacity, comms pinning, blur. Mirrors mango/rule.conf.

// === Global defaults ===
window-rule {
    opacity 0.97
    background-effect {
        blur true
    }
}

// === Comms (pinned to "comms" workspace on Philips) ===
window-rule {
    match app-id=r#"^vesktop$"#
    default-column-width { proportion 0.5; }
    open-on-workspace "comms"
    opacity 0.85
}

window-rule {
    match app-id=r#"^signal$"#
    default-column-width { proportion 0.5; }
    open-on-workspace "comms"
    opacity 0.85
}
window-rule {
    match app-id=r#"^tidal-hifi$"#
    default-column-width { proportion 0.5; }
    open-on-workspace "comms"
    opacity 0.85
}

// === Editors ===
window-rule {
    match app-id=r#"^dev\.zed\.Zed$"#
    match app-id=r#"^zeditor$"#
    opacity 0.97
}

// === Browser ===
window-rule {
    match app-id=r#"^zen$"#
    match app-id=r#"^zen-browser$"#
    match app-id=r#"^app\.zen_browser\.zen$"#
    opacity 0.97
}

// === Notes ===
window-rule {
    match app-id="obsidian"
    opacity 0.97
}

// === File manager ===
window-rule {
    match app-id=r#"^org\.gnome\.Nautilus$"#
    opacity 0.95
}

// === Steam client (pinned to "gaming" on Alienware) ===
// Main window only — not games (steam_app_*) or floating toasts.
window-rule {
    match app-id="^steam$"
    default-column-width { proportion 1.0; }
    exclude title=r#"^notificationtoasts_\d+_desktop$"#
    open-on-workspace "gaming"
    opacity 0.95
}

// === Steam games — restore primary-plane direct scanout ===
// The global clip-to-geometry + sub-1.0 opacity both block direct scanout;
// revert them so fullscreen game frames bypass the compositor entirely.
window-rule {
    match app-id=r#"^steam_app_.*$"#
    open-on-workspace "gaming"
    geometry-corner-radius 0
    clip-to-geometry false
    opacity 1.0
    variable-refresh-rate true
}

// === Background blur (xray) ===
// These run at 0.85 opacity so the blur shows; xray is implicit with blur —
// only the wallpaper is blurred, not windows behind.
window-rule {
    match app-id=r#"^vesktop$"#
    background-effect {
        blur true
    }
}
window-rule {
    match app-id=r#"^signal$"#
    background-effect {
        blur true
    }
}
window-rule {
    match app-id=r#"^tidal-hifi$"#
    background-effect {
        blur true
    }
}
window-rule {
    match app-id=r#"^zen-browser$"#
    match app-id=r#"^app\.zen_browser\.zen$"#
    background-effect {
        blur true
    }
}

// === Floating terminal ===
window-rule {
    match app-id="com.ghostty.floating"
    open-floating true
}
