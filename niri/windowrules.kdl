// Niri window rules — per-app opacity, comms pinning, blur. Mirrors mango/rule.conf.

// === Global defaults ===
window-rule {
    opacity 0.97
    background-effect {
        blur true
    }
}

// === Comms (pinned to "comms" workspace on Philips) ===
window-rule {
    match app-id=r#"^vesktop$"#
    match app-id=r#"^signal$"#
    match app-id=r#"^tidal-hifi$"#
    default-column-width { proportion 0.5; }
    open-on-workspace "comms"
    opacity 0.85
}

// === Editors ===
window-rule {
    match app-id=r#"^dev\.zed\.Zed$"#
    match app-id=r#"^zeditor$"#
    opacity 0.97
}

// === Browser ===
window-rule {
    match app-id=r#"^zen$"#
    match app-id=r#"^zen-browser$"#
    match app-id=r#"^zen-beta$"#
    match app-id=r#"^app\.zen_browser\.zen$"#
    opacity 0.97
}

// === Notes ===
window-rule {
    match app-id="obsidian"
    opacity 0.97
}

// === File manager ===
window-rule {
    match app-id=r#"^org\.gnome\.Nautilus$"#
    opacity 0.95
}

// === Steam client (pinned to "gaming" on Alienware) ===
// Main window only — not games (steam_app_*) or floating toasts.
window-rule {
    match app-id="^steam$"
    default-column-width { proportion 1.0; }
    exclude title=r#"^notificationtoasts_\d+_desktop$"#
    open-on-workspace "gaming"
    opacity 0.95
}

// === Steam games — restore primary-plane direct scanout ===
// The global clip-to-geometry + sub-1.0 opacity both block direct scanout;
// revert them so fullscreen game frames bypass the compositor entirely.
window-rule {
    match app-id=r#"^steam_app_.*$"#
    open-on-workspace "gaming"
    geometry-corner-radius 0
    clip-to-geometry false
    opacity 1.0
    variable-refresh-rate true
    open-fullscreen true
}

// Pre-launch "Launcher" windows (updaters, EAC/BattlEye prompts, etc.) share
// the steam_app_ appid with the actual game, so the rule above was tiling
// them too. Float them back to their own requested size. Confirmed via
// Marvel Rivals (appid steam_app_2767030): title starts as "broken" (Proton
// placeholder) then flips to "Launcher".
window-rule {
    match app-id=r#"^steam_app_.*$"# title=r#"^(Launcher|broken)$"#
    open-floating true
}

// === Background blur (xray) ===
// These run at 0.85 opacity so the blur shows; xray is implicit with blur —
// only the wallpaper is blurred, not windows behind.
window-rule {
    match app-id=r#"^vesktop$"#
    match app-id=r#"^signal$"#
    match app-id=r#"^tidal-hifi$"#
    background-effect {
        blur true
    }
}
window-rule {
    match app-id=r#"^zen-browser$"#
    match app-id=r#"^zen-beta$"#
    match app-id=r#"^app\.zen_browser\.zen$"#
    background-effect {
        blur true
    }
}

// === Floating terminal ===
window-rule {
    match app-id="com.ghostty.floating"
    open-floating true
}

// === Floating Kitty (matches --app-id=floating-kitty) ===
window-rule {
    match app-id="floating-kitty"
    open-floating true
    default-column-width { proportion 0.4; }
    default-window-height { proportion 0.5; }
}

// === Satty screenshot editor (Super+Shift+S) ===
window-rule {
    match app-id=r#"^com\.gabm\.satty$"#
    open-floating true
    default-column-width { proportion 0.7; }
    default-window-height { proportion 0.7; }
}

// === Per-app opacity: focused 0.95, unfocused 0.90 ===
window-rule {
    match app-id="signal"
    match is-focused=true
    opacity 0.95
}
window-rule {
    match app-id="signal"
    match is-focused=false
    opacity 0.90
}
window-rule {
    match app-id="vesktop"
    match is-focused=true
    opacity 0.95
}
window-rule {
    match app-id="vesktop"
    match is-focused=false
    opacity 0.90
}
window-rule {
    match app-id="obsidian"
    match is-focused=true
    opacity 0.95
}
window-rule {
    match app-id="obsidian"
    match is-focused=false
    opacity 0.90
}
