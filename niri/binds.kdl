binds {
    // Unified keybinds — mirrors mango/bind.conf. NixOS patches this file
    // (home/dotfiles.nix seds match exact lines; rewording breaks the build).
    // Tiers: Mod=focus · +Shift=move window · +Ctrl=cross boundary · +Ctrl+Alt=move across.

    // === System ===
    Mod+Q { close-window; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Ctrl+Alt+Delete { quit; }

    // === Terminal ===
    Mod+Return { spawn "ghostty"; }
    Mod+Ctrl+Return { spawn "ghostty" "--gtk-single-instance=false" "--class=com.ghostty.floating"; }

    // === App Launcher ===
    Mod+Space { spawn "noctalia" "msg" "panel-toggle" "launcher"; }

    // === App Spawns ===
    Mod+Shift+B { spawn "zen-browser"; }
    Mod+Shift+E { spawn "nautilus"; }
    Mod+Shift+D { spawn "mullvad-exclude" "vesktop"; }
    Mod+Shift+G { spawn "signal-desktop"; }
    Mod+Shift+O { spawn "obsidian"; }
    Mod+Shift+M { spawn "tidal-hifi"; }
    Mod+Shift+Alt+B { spawn "zen-browser" "--private-window"; }
    Mod+Shift+Z { spawn "zeditor"; }

    // === Noctalia ===
    Mod+Escape    { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+Backslash { spawn "noctalia" "msg" "panel-toggle" "control-center" "audio"; }

    Mod+Alt+E { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "emoji"; }
    Mod+Alt+W { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "wallpaper" "toggle"; }
    Mod+Alt+R { spawn-sh "killall qs && qs -c noctalia-shell &"; }

    // === Navigation: Focus ===

    // Focus column L/R (within workspace)
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }
    Mod+WheelScrollRight { focus-column-right; }

    // Focus window U/D (within column)
    Mod+Up   { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+K    { focus-window-up; }
    Mod+J    { focus-window-down; }

    // Focus monitor L/R
    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Ctrl+L     { focus-monitor-right; }

    // Focus workspace U/D
    Mod+Ctrl+Up   { focus-workspace-up; }
    Mod+Ctrl+Down { focus-workspace-down; }
    Mod+Ctrl+K    { focus-workspace-up; }
    Mod+Ctrl+J    { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }

    // === Navigation: Move focused window ===

    // Move column L/R (within workspace)
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+WheelScrollLeft  { move-column-left; }
    Mod+Shift+WheelScrollRight { move-column-right; }

    // Move window U/D (within column)
    Mod+Shift+Up   { move-window-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+K    { move-window-up; }
    Mod+Shift+J    { move-window-down; }

    // Move column to monitor L/R
    Mod+Ctrl+Alt+Left  { move-column-to-monitor-left; }
    Mod+Ctrl+Alt+Right { move-column-to-monitor-right; }
    Mod+Ctrl+Alt+H     { move-column-to-monitor-left; }
    Mod+Ctrl+Alt+L     { move-column-to-monitor-right; }
    Mod+Ctrl+Alt+WheelScrollLeft  { move-column-to-monitor-left; }
    Mod+Ctrl+Alt+WheelScrollRight { move-column-to-monitor-right; }

    // Move column to workspace U/D
    Mod+Ctrl+Alt+Up   { move-column-to-workspace-up; }
    Mod+Ctrl+Alt+Down { move-column-to-workspace-down; }
    Mod+Ctrl+Alt+K    { move-column-to-workspace-up; }
    Mod+Ctrl+Alt+J    { move-column-to-workspace-down; }
    Mod+Ctrl+Alt+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Ctrl+Alt+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }

    // === Workspaces by index (1-6) ===
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }

    // === Window States ===
    Mod+W       { toggle-window-floating; }
    Mod+Shift+W { switch-focus-between-floating-and-tiling; }
    Mod+F       { fullscreen-window; }
    Mod+M       { maximize-column; }
    Mod+C       { center-column; }
    Mod+X       { toggle-overview; }
    Mod+Tab     { toggle-overview; }

    // === Column Management (Niri-specific, no Mango equivalent) ===
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // === Resize ===
    Mod+Minus       { set-column-width "-5%"; }
    Mod+Equal       { set-column-width "+5%"; }
    Mod+Shift+Minus { set-window-height "-5%"; }
    Mod+Shift+Equal { set-window-height "+5%"; }
    Mod+R           { switch-preset-column-width; }
    Mod+Shift+R     { switch-preset-column-width-back; }
    Mod+Ctrl+R      { reset-window-height; }

    // === Screenshots ===
    Alt+Shift+S { screenshot; }  // region to clipboard (Niri's built-in overlay)
    Mod+Shift+S { spawn "bash" "-c" "grim -g \"$(slurp)\" ~/Pictures/Screenshots/$(date +%s).png"; }

    // === Media Keys ===
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
}
