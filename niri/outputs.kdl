// === Monitors ===
// Outputs are addressed by identity string (make/model/serial), NOT port
// name — the DP-N index flips between boots on this box.
// Never switch these to DP-N names.
output "Dell Inc. Dell AW3423DW #tBszGDAYBQUH" {
    mode "3440x1440@174.963"
    scale 1
    position x=0 y=0
    focus-at-startup
    // VRR off: on the RX 9070 XT, fullscreen VRR stutters on this G-SYNC-module monitor
    // (same as hypr/monitor.lua and mango/monitor.conf).
}

output "Philips Consumer Electronics Company PHL 278E1 0x0000065F" {
    mode "3840x2160@59.997"
    scale 1.5
    position x=3440 y=0
}
