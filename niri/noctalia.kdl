layout {

    focus-ring {
        active-color   "#a7ccdc"
        inactive-color "#121415"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a7ccdc"
        inactive-color "#121415"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#a7ccdc"
        inactive-color "#1d4350"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a7ccdc80"
    }
}

recent-windows {
    highlight {
        active-color "#a7ccdc"
        urgent-color "#ffb4ab"
    }
}
