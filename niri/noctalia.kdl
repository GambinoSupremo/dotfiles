layout {

    focus-ring {
        active-color   "#83d1f4"
        inactive-color "#101416"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#83d1f4"
        inactive-color "#101416"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#83d1f4"
        inactive-color "#004d64"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#83d1f480"
    }
}

recent-windows {
    highlight {
        active-color "#83d1f4"
        urgent-color "#ffb4ab"
    }
}
