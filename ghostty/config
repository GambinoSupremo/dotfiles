# Ghostty terminal config.
# Ghostty starts the login shell (fish on NixOS). The `theme = noctalia` file is
# runtime-generated by Noctalia and seeded writable on NixOS — never a store symlink.

# Font
font-family = JetBrainsMono Nerd Font
font-size = 12

# Window
background-opacity = 0.8
# Requests blur on KWin/KineticWE; Hyprland ignores it (blurs via its own config).
background-blur = true
# Single-instance mode reuses one GTK app/process for every Mod+Return spawn;
# only the window that initializes the app gets background-opacity applied
# correctly, so later windows come out opaque. Disabled to match the floating
# terminal bind, which already worked around this per-window.
gtk-single-instance = false
window-decoration = none
window-padding-x = 12
window-padding-y = 12
confirm-close-surface = false

# Cursor
cursor-style = block
cursor-style-blink = true

# Scrollback
scrollback-limit = 10000000

keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard

theme = noctalia
